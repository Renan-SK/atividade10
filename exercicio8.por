programa {
  funcao inicio() {
    // real
    // inteiro
    // cadeia
    // logico

  real valor1, valor2, soma, subtracao, divisao, multiplicacao

    escreva("digite o seu primeiro numero para calculo \n")
    leia(valor1)

    escreva("digite o seu segundo numero para calculo \n")
    leia(valor2)

    soma = valor1 + valor2
    subtracao = valor1 - valor2
    divisao = valor1 / valor2
    multiplicacao = valor1 * valor2

    escreva("valor da sua soma é ", soma, "\n") 
    escreva("valor da sua subtracao é ", subtracao, "\n")
    escreva("valor da sua divisao é ", divisao, "\n")
    escreva("valor da sua multiplicacao é ", multiplicacao, "\n")
  }
}
